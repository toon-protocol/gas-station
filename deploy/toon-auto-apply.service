[Unit]
Description=Apply the merged TOON node bundle (fast-forward, render, compose up)
Documentation=https://github.com/toon-protocol/gas-station/blob/main/deploy/README.md
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/root/gas-station/deploy/auto-apply.sh
# The script takes its own flock; this only stops systemd stacking runs.
TimeoutStartSec=600
