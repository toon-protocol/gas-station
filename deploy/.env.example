# =============================================================================
# gas-station box configuration — copy to .env and fill in.
# =============================================================================
# .env is gitignored. Two files are rendered from it by ./render.sh:
# connector.toml and nginx/conf.d/node.conf.

# ── Required ─────────────────────────────────────────────────────────────────

# The zone the box's hostnames live under. Two A-records must point here:
#   proxy.gas.${DOMAIN}   the paid ILP edge
#   gas.${DOMAIN}         health
DOMAIN=devnet.toonprotocol.dev

# Where Let's Encrypt sends expiry warnings.
LETSENCRYPT_EMAIL=you@example.com

# Leave at 1 until DNS resolves to this box, then set 0 and re-run
# ./init-letsencrypt.sh. Staging certificates are untrusted by browsers but do
# not burn the production rate limit while you are still wiring DNS up.
LETSENCRYPT_STAGING=1

# This node's Nostr identity — 64 hex characters, NOT a mnemonic.
#   openssl rand -hex 32
GAS_STATION_NOSTR_SECRET_KEY=

# Gates the connector's /metrics and redeem endpoints. Any random secret:
#   openssl rand -hex 32
# Rotate it by changing it here, re-running ./render.sh, and restarting the
# connector (the config is read once at startup).
OPERATOR_BEARER_TOKEN=

# The Nostr pubkey (64 hex) permitted to sign operator writes.
OPERATOR_WRITE_KEY=

# ── The chains this station serves ───────────────────────────────────────────
# At least one of the two must be set, or the app refuses to boot: a gas
# station with no chain configured would answer nothing.
#
# Every key here is a WORKING FLOAT that this node spends on other people's
# behalf. Fund each one with what you are willing to lose, keep them separate
# from the connector's settlement keys (those are files, mounted into a
# different container), and watch the balances — the app refuses to quote once
# a float cannot cover roughly two jobs, which reads as `float_exhausted` to
# every caller.

# ── kind:5096 — Solana ───────────────────────────────────────────────────────
# The DEDICATED fee-payer wallet: 128 hex characters, a 64-byte Ed25519 keypair
# (secretKey ‖ publicKey). This key co-signs transactions other people wrote,
# so it holds working SOL and nothing else.
GAS_STATION_SOLANA_SECRET_KEY=

# devnet (default) | mainnet. Chooses the cluster and which ar.io programs are
# on the whitelist. Mainnet is explicit opt-in.
SOLANA_NETWORK=devnet

# Optional: your own RPC. The public cluster endpoints are heavily
# rate-limited, and a rate-limited quote reads to the caller as a failure.
SOLANA_RPC_URL=

# Optional: let the station co-sign TOON payment-channel deposit / close /
# settle, so an agent can fund or reclaim its own channel without holding SOL.
# Use the program_id the connector in front of this box settles against — see
# [settlement.solana] in connector.toml.template. It belongs to that
# deployment and rotates with it, so do not treat it as a constant.
GAS_STATION_CHANNEL_PROGRAM_ID=2aEVJ8koKD8LTZrLRSGtAtU7LBt4e7QjjCgf1kzQ7Rip

# Optional: raise the merged quote/blockhash deadline for a slow client
# ceremony. Keep it under Solana's blockhash validity (~60-90s) or execute
# answers blockhash_expired.
GAS_STATION_QUOTE_TTL_MS=

# ── kind:5098 — EVM ──────────────────────────────────────────────────────────
# A JSON array, one entry per chain, each with its own DEDICATED relayer
# wallet. Adding a chain is an entry here, not a code change. This variable
# carries private keys.
#
# The devnet's Base Sepolia entry, with the relayer key left blank:
#
# EVM_GAS_STATION_CONFIG_JSON=[{"chainId":84532,"rpcUrl":"https://base-sepolia-rpc.publicnode.com","forwarderAddress":"0xf1b0B8BA9CA90A0779C382Fe4212a3D4C5646Ee9","tokenNetworkAddress":"0xa79C3b1dbcEA00a6d84735a134395D8eF6D6a478","relayerPrivateKey":"0x..."}]
EVM_GAS_STATION_CONFIG_JSON=

# Optional: overrides the 120s quote deadline and the 300,000 gas cap per
# forwarded call.
EVM_GAS_STATION_QUOTE_TTL_MS=
EVM_GAS_STATION_MAX_GAS=

# ── Optional ─────────────────────────────────────────────────────────────────

# An existing certificate lineage to keep using, if this box already has one
# filed under a different name. Defaults to proxy.gas.${DOMAIN}.
# CERT_NAME=

LOG_LEVEL=info

# ── Discovery (optional) ─────────────────────────────────────────────────────
# Publishing a kind:10032 self-announce is how clients FIND this node. It is a
# paid write through another node's client edge, so it needs a funded payment
# channel — which is why it is off until you set these. Without them the box
# still serves; it is just not listed.
#
# Set all four together, re-run ./render.sh (which writes the [announce]
# section only when ANNOUNCE_PAY_CHANNEL is present), then:
#   docker compose --profile announce up -d
#
# The ILP address of the node you publish through, and its BTP URL.
ANNOUNCE_PUBLISH_TO=g.toon.relay
ANNOUNCE_PUBLISH_BTP_URL=wss://proxy.relay.devnet.toonprotocol.dev/ilp/btp
# The HTTP edge the announce container dials (it probes ${URL}/identity first).
ANNOUNCE_THROUGH_URL=https://proxy.relay.devnet.toonprotocol.dev/ilp
# The 32-byte channel id (0x-prefixed) this node pays the write from.
ANNOUNCE_PAY_CHANNEL=
# How often to refresh the announce, in seconds.
ANNOUNCE_REFRESH_SECS=240
