# =============================================================================
# Connector config for the gas-station box — rendered by ./render.sh
# =============================================================================
# The connector is the payment proxy in front of the gas station. It meters and
# settles the payment, then reverse-proxies the job to the app over plain HTTP.
# Everything the connector needs is in this one file.
#
# Three rules the parser enforces, worth knowing before you edit:
#
#   * One TOML file, read once at startup, immutable for the process
#     lifetime. There is NO environment-variable layer — the only variable the
#     connector reads is RUST_LOG. Editing this file does nothing until the
#     container restarts (a bind mount is not a reload).
#   * Unknown keys are a hard startup failure, and removed keys are refused by
#     name. That is the behaviour you want — a stale config says so at boot
#     instead of quietly doing nothing — but it means a config change and a
#     connector upgrade must land in the right order. Land config first.
#   * Every key that carries a secret is a PATH, never the value — the
#     operator credentials included. Nothing in this file is a credential, so
#     the rendered connector.toml is not a secret.
#
# ── This file targets an exact, immutable build ──────────────────────────────
# `docker-compose.yml` pins the connector to one immutable tag -- either a
# `rust-sha-<commit>` build or a `rust-<YYYY.MM.DD.N>` release handle.
# It used to follow the fleet's `:rust-release` pointer; nothing moves that
# pointer any more (connector ADR 0068 — a node repository pins the connector
# it runs, in one place, guarded there), so following it meant standing still.
#
# Bumping the pin is a reviewed commit here: change the image tag in
# docker-compose.yml and the matching literal in
# src/deploy-bundle-guard.test.ts together, land this file's changes FIRST if
# the new build wants a different schema, then move the tag. The parser is
# `deny_unknown_fields` and startup is fail-closed, so a schema drift under you
# is a refuse-to-start, never a degraded run.
# =============================================================================

# The client edge: POST /ilp, GET /ilp/btp, GET /ilp/identity and /metrics all
# share this port. Bound to 0.0.0.0 INSIDE the container only — docker-compose
# publishes it on 127.0.0.1, and nginx is what faces the internet.
client_edge_addr = "0.0.0.0:4000"

# Where this node records which claims it has already been paid. This MUST be a
# mounted volume: a watermark that dies with the container hands every payer
# their spent claims back as free service.
state_dir = "/app/state"

# Which peer carriage this node listens on. The relay establishes a peering
# with this node over the operator surface (connector ADR 0058) and dials the
# BTP endpoint `[node]` publishes below; without this line no peer listener is
# mounted at all and the relay's packets would be admitted as an ordinary
# client's. "btp" opens exactly that one carriage on the same :4000 socket.
peer_expose = "btp"

# This node's signing identity. `GET /ilp/identity` answers with this key, and
# every gift-wrapped packet is sealed to it.
[signer]
key_file = "/app/data/signer.key"


# ── What this node sells ─────────────────────────────────────────────────────
# One route, one app. A paid packet for this prefix is delivered as a plain
# HTTP POST to `handler_url` (RouteTermination) and the app's answer comes back
# in the FULFILL.
#
# The `/gas` suffix is load-bearing — the app serves POST /gas, and a bare
# `http://gas-station:3300` comes back as F99 "app declined the delivery with
# HTTP 404".
#
# `price` is a whole number of the SMALLEST UNIT of the settlement token, the
# way a card terminal counts in cents. USDC has 6 decimals, so:
#
#     price = 1000       0.001 USDC     a tenth of a cent   <- this route
#     price = 100000     0.10  USDC     ten cents
#     price = 1000000    1.00  USDC     one dollar
#
# ── Pricing a gas station is not like pricing a store ────────────────────────
# This node spends REAL VALUE on behalf of the caller: the fee it pays to land
# a Solana transaction, or the gas it burns relaying an EVM meta-transaction.
# A store upload costs the operator credits it bought in bulk; a gas job costs
# the operator native token at whatever the chain charges that second.
#
# A price is charged per JOB, and the connector prices per handler_url. The
# app serves three doors so the two phases can be priced apart:
#
#     /gas/quote     quote only    costs this node nothing
#     /gas/execute   execute only  costs this node real gas, up to the ceiling
#     /gas           either        one price for both (the original shape)
#
# On a MAINNET station price the execute route at what the per-job ceiling
# buys (`GAS_STATION_MAX_LAMPORTS_CEILING` × the native token's price, in the
# settlement token's smallest unit) and the quote route at next to nothing;
# then no job can cost the float more than its caller paid. Two things still
# hold either way:
#
#   * the per-job ceilings in the app (`maxLamportsCeiling`, `maxGas`) bound
#     what any single execute can cost this node, and
#   * the float checks refuse to quote at all once the wallet cannot cover
#     roughly two jobs' worth.
#
# So the failure mode of underpricing is "the float drains and the node starts
# answering `float_exhausted`", not "the node signs something ruinous". Watch
# the float; raise the price if a job costs you more than it earns.
#
# This devnet box settles in play money, so both doors stay at 1000 here. The
# split is still real: an execute through `g.toon.gas.quote` is refused F00
# (charged at the quote price, if the connector charges rejects; never run).
[[routes]]
prefix      = "g.toon.gas.quote"
handler_url = "http://gas-station:3300/gas/quote"
price       = 1000

[[routes]]
prefix      = "g.toon.gas"
handler_url = "http://gas-station:3300/gas/execute"
price       = 1000

# The same app under the relay's name for it. The relay forwards
# `g.toon.relay.gas` here over the peering it established, and a forward does
# not rewrite the destination — packets arrive addressed to this prefix and
# need a route of their own. Priced identically to `g.toon.gas` because the
# two share a `handler_url`, and the connector refuses a config where one
# handler is reachable at two prices (the cheaper door would take every
# packet). The relay forwards to the execute door; a cheap quote through the
# relay would be a second forward, not this row.
[[routes]]
prefix      = "g.toon.relay.gas"
handler_url = "http://gas-station:3300/gas/execute"
price       = 1000


# ── Getting paid ─────────────────────────────────────────────────────────────
# Settlement is per-chain. A client pays in whichever of these it holds; the
# connector verifies the claim against the chain named here.
#
# BOTH chains are configured, and for a gas station that is close to
# mandatory rather than thorough: the whole point of this app is serving a
# caller who does not hold chain X's gas token. That caller pays in what they
# DO hold — very often the other chain. A single-chain gas station refuses the
# traffic it exists to serve.
#
# Each table is a fail-closed dependency: startup resolves the token through
# the registry and reads its `decimals()` on chain, so a wrong RPC or a
# registry that will not answer is exit 1 at boot, not a runtime surprise.

[settlement.evm]
rpc_url          = "https://base-sepolia-rpc.publicnode.com"
contract_address = "0x0c41D9D424d6B075A3cEa1068a694f7847a8CCa5"  # TokenNetworkRegistry
token_address    = "0x49beE1Bca5d15Fb0963117923403F9498119a9Ce"  # USDC (6dp)
decimals         = 6

[settlement.evm.key]
key_file = "/app/data/settlement.key"

# `[settlement.solana]` is APPENDED by ./render.sh when SETTLEMENT_SOLANA=on.
# It is not in this template because it is fail-closed in a way the EVM table
# is not: EVM startup only READS the chain (resolve the token through the
# registry, ask it for `decimals()`), while Solana startup simulates a
# transaction — which an account holding no SOL cannot do. Point a connector
# at an unfunded Solana settlement key and it exits 1 at boot with
#
#     RPC response error -32002: Transaction simulation failed:
#     Attempt to debit an account but found no record of a prior credit.
#
# and restart-loops. That is correct behaviour (a node that cannot settle
# should not pretend to), but it makes "fund the key" a PRECONDITION of the
# first boot rather than a follow-up — so turning the table on is a separate,
# deliberate step, taken once the key has SOL. See deploy/README.md
# § Funding the floats.


# ── The operator surface ─────────────────────────────────────────────────────
# Gates /metrics and the redeem endpoints. Without this section they are not
# mounted at all (404, not 401) — which also means no way to redeem what you
# have earned, so it is not optional in practice.
#
# Both are FILE-VALUED, like every other credential this file names. The
# values live in two files render.sh writes from .env (`OPERATOR_BEARER_TOKEN`
# and `OPERATOR_WRITE_KEY`), 0600 and owned by uid 10001, mounted beside the
# key files — so the rendered connector.toml holds paths and nothing else. A
# section naming a file that is missing or empty is a refuse-to-start, never a
# silently open surface.
#
# `write_keys_file` is the allowlist of RFC 9421 signing keys for operator
# WRITES — `POST /peers`, `POST /routes/peers`, `POST /channels/:id/fund` —
# one PUBLIC key per line, `#` starts a comment. The private half never lives
# on this box. To sign a write from a shell, use the connector repo's
# docs/operators/sign-write.sh. Revoke a key by deleting its line from
# operator-write.keys and restarting.
[operator]
bearer_token_file = "/app/data/operator-bearer.token"
write_keys_file   = "/app/data/operator-write.keys"


# ── Peering: established by the relay, at runtime ───────────────────────────
# No `[[peers]]` table, and none should be added: the relay peers with this
# node through ITS operator surface — `POST /peers` at this node's URL reads
# the `[node]` self-description below, derives the payment channel from the
# two settlement addresses (ADR 0059), opens it on chain if absent, and dials
# the BTP endpoint. This node's side of the same channel is bound the same way
# in reverse (`POST /peers` here naming the relay's URL), and the rows live in
# the state volume (`runtime-peers.json`), not in this file.
#
# A `[[peers]]` row for the relay here would take that peering away from the
# operator surface for good: a runtime write is refused when the config file
# owns the id, and a durable runtime row whose id config later claims is
# deleted, not shadowed.


# ── What this node says about itself ────────────────────────────────────────
# The facts a node cannot introspect: the prefixes it terminates and the
# public URLs it is reachable on. `GET /ilp` serves them as the
# self-description a counterparty's `POST /peers` reads. Both endpoints are
# the PUBLIC names — inside the container the node only ever sees
# 0.0.0.0:4000 — and nginx carries `/ilp/btp`'s WebSocket upgrade to the
# connector.
#
# `addresses` lists every prefix terminated above: a route this node
# terminates but does not advertise is one no client can discover.
[node]
addresses     = ["g.toon.gas", "g.toon.gas.quote", "g.toon.relay.gas"]
http_endpoint = "https://proxy.gas.${DOMAIN}/ilp"
btp_endpoint  = "wss://proxy.gas.${DOMAIN}/ilp/btp"


